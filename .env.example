# build
ENV_PRODUCT=true

# server
SERVER_HOST=0.0.0.0
SERVER_PORT=3001

LOG_LEVEL=info
PROJECT_NAME=libretranslate-frontpage

# ===== LibreTranslate 上游 API =====
# 上游 LibreTranslate API 地址（必填，如 https://translator.api.soraharu.com）
LT_API_URL=https://translator.api.soraharu.com
# 内置 API key（可选）：登录用户通过本服务代理翻译时自动注入
LT_API_KEY=
# 登录用户的前端字符上限（可选，应与内置 key 在上游的配额一致，如 100000）。
# 上游 /frontend/settings 只返回全局匿名上限，无法感知 key；配置后登录用户输入框即放宽至此值。
# 0 或留空 = 不覆盖，登录用户仍沿用上游匿名上限。
LT_LOGIN_CHAR_LIMIT=100000

# ===== OpenID Connect 登录 =====
# 标准授权码流 + S256 PKCE，至少支持 Keycloak，其它 IdP 可配置适配
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 回调地址，须与 IdP 中注册的 Redirect URI 完全一致，例如 https://your.domain/api/auth/callback
OIDC_REDIRECT_URI=
# 请求 scope（默认 openid profile email，可覆盖）
# OIDC_SCOPE=openid profile email
# 用户名取自 userinfo 的 claim（Keycloak 为 preferred_username，可改 name/sub 适配其它 IdP）
# OIDC_USERNAME_CLAIM=preferred_username
# SSO 提供商名称，显示在登录弹窗的按钮上（留空则使用界面语言的默认文案）
# OIDC_PROVIDER_NAME=
# SSO 用户中心地址；配置后登录时右上角用户名变为可点击链接。只接受 http/https
# OIDC_ACCOUNT_URL=
# 登出 SSO 时 IdP 回跳的地址（留空则自动取 OIDC_REDIRECT_URI 的站点根，如 https://your.domain/）
# 需在 IdP 客户端配置中登记该 Post Logout Redirect URI
# OIDC_POST_LOGOUT_REDIRECT_URI=

# ===== 会话 =====
# 会话签名密钥（必填，至少 32 字符随机串）
SESSION_SECRET=
# 会话 Cookie 名与有效期（秒，默认 7 天）
# SESSION_COOKIE_NAME=lt_session
# SESSION_TTL=604800

# 静态资源目录（可选，默认自动解析：生产 dist/public，开发 public）
# STATIC_DIR=
